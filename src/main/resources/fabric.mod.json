{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    {
      "name": "Cammie",
      "contact": {
        "homepage": "https://cammiescorner.dev",
        "github": "https://github.com/CammiePone",
        "bsky": "https://bsky.app/profile/did:plc:mrfyoh5nqmmuztcsmklcihfv",
        "curseforge": "https://www.curseforge.com/members/cammie",
        "modrinth": "https://modrinth.com/user/Cammie"
      }
    },
    {
      "name": "Up",
      "contact": {
        "homepage": "https://upcraft.dev",
        "github": "https://github.com/UpcraftLP",
        "bsky": "https://bsky.app/profile/did:plc:77uzn2lx2zhtdgr5zfvzumji",
        "curseforge": "https://www.curseforge.com/members/upcraftlp",
        "modrinth": "https://modrinth.com/user/Up"
      }
    }
  ],
  "contact": {
    "homepage": "${homepage_url}",
    "issues": "${issues_url}",
    "sources": "${sources_url}"
  },
  "license": "${license_url}",
  "icon": "icon.png",
  "entrypoints": {
    "cardinal-components": ["dev.cammiescorner.cammiesminecarttweaks.init.MTComponents"]
  },
  "custom": {
    "cardinal-components": [
      "${mod_id}:linkable",
      "${mod_id}:powered_minecart"
    ],
    "mc-publish": {
      "curseforge": "${curseforge_id}",
      "modrinth": "${modrinth_id}",
      "dependencies": [
        "fabric-api(required){curseforge:306612}{modrinth:P7dR8mSH}",
        "cardinal-components-base(required){curseforge:318449}{modrinth:K01OU20C}",
        "cardinal-components-entity(required)#(ignore)",
        "commonnetworking(required){curseforge:806044}{modrinth:HIuqnQpi}",
        "resourcefulconfig(required){curseforge:714059}{modrinth:M1953qlQ}",
        "sparkweave(required){curseforge:911456}{modrinth:nf68xfAw}",
        "modmenu(optional){curseforge:308702}{modrinth:mOgUt4GM}"
      ],
      "loaders": [
        "fabric",
        "quilt"
      ]
    },
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord_url}"
      }
    }
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "cardinal-components-base": "*",
    "cardinal-components-entity": "*",
    "commonnetworking": "*",
    "resourcefulconfig": "*",
    "sparkweave": "*"
  },
  "environment": "*",
  "accessWidener": "${mod_id}.classtweaker",
  "mixins": [
    "${mod_id}.mixins.json"
  ]
}
